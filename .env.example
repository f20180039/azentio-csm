# Copy to .env and fill in the keys you have. Never commit .env.
# docker compose reads .env automatically; natively run the agent with
#   .venv/bin/uvicorn app.main:app --port 8000 --env-file ../.env

# ---- Which models answer, in order -------------------------------------------
# The first provider is tried first. On an error, timeout, rate limit or refusal the
# next one answers, and a failed provider sits out for LLM_COOLDOWN_S seconds so
# later requests don't wait on it. Providers without a key are skipped instantly.
# Choices: anthropic, gemini, groq, mistral, ollama, mock
#
# Default: free tiers only, Groq first because it is fastest for live voice, then a
# local model, then mock so the demo never dies.
LLM_PROVIDER=groq
LLM_FALLBACK=gemini,mistral,ollama,mock
# Offline (no Wi-Fi at the venue):
# LLM_PROVIDER=ollama
# LLM_FALLBACK=mock

LLM_COOLDOWN_S=30
LLM_TIMEOUT_S=60

# ---- Anthropic ----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_REASONING_MODEL=claude-sonnet-5-5

# ---- Google Gemini (OpenAI-compatible endpoint) -------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash

# ---- Groq (OpenAI-compatible endpoint) ----------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# ---- Mistral (OpenAI-compatible endpoint) -------------------------------------
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_REASONING_MODEL=mistral-large-latest

# ---- Local model (no key, works offline) --------------------------------------
# Inside docker compose this is overridden to http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Text to speech (voice topics only) ---------------------------------------
# edge_tts is free but needs internet; elevenlabs is billed per character.
TTS_PROVIDER=edge_tts
EDGE_TTS_VOICE=en-IN-NeerjaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- API ----------------------------------------------------------------------
WORKER_CONCURRENCY=4
