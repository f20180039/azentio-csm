# Copy to .env and fill in the keys you have. Never commit .env.
# docker compose reads .env automatically; natively run the agent with
#   .venv/bin/uvicorn app.main:app --port 8000 --env-file ../.env

# ---- Which models answer, in order -------------------------------------------
# The first provider is tried first. On an error, timeout, rate limit or refusal the
# next one answers, and a failed provider sits out for LLM_COOLDOWN_S seconds so
# later requests don't wait on it. Providers without a key are skipped instantly.
# Choices: anthropic, gemini, groq, mistral, ollama, mock
#
# Default: free tiers only, Groq first because it is fastest for live voice, then a
# local model, then mock so the demo never dies.
LLM_PROVIDER=groq
LLM_FALLBACK=gemini,mistral,ollama,mock
# Offline (no Wi-Fi at the venue):
# LLM_PROVIDER=ollama
# LLM_FALLBACK=mock

LLM_COOLDOWN_S=30
LLM_TIMEOUT_S=60

# ---- Anthropic ----------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_REASONING_MODEL=claude-sonnet-5-5

# ---- Google Gemini (OpenAI-compatible endpoint) -------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash

# ---- Groq (OpenAI-compatible endpoint) ----------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# ---- Mistral (OpenAI-compatible endpoint) -------------------------------------
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_REASONING_MODEL=mistral-large-latest

# ---- Local model (no key, works offline) --------------------------------------
# Inside docker compose this is overridden to http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Text to speech (voice topics only) ---------------------------------------
# edge_tts is free but needs internet; elevenlabs is billed per character.
TTS_PROVIDER=edge_tts
EDGE_TTS_VOICE=en-IN-NeerjaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- API ----------------------------------------------------------------------
WORKER_CONCURRENCY=4
# The API refuses to start renewal calls outside calling hours. false = demo at any time.
ENFORCE_CALLING_HOURS=true

# ---- Voice service (Renewal Desk) ---------------------------------------------
# Uses GROQ_API_KEY above for speech to text. The conversation runs on the first model in
# VOICE_LLM_CHAIN that is not resting after a rate limit, outage or timeout; links whose
# provider key is missing are skipped and anthropic is refused. Needs internet
# (edge-tts calls Microsoft's read-aloud service). Natively run with
#   cd voice && .venv/bin/uvicorn app.main:app --port 7861
# Inside docker compose RENEWALS_API_BASE is overridden to http://api:8080/api/v1.
RENEWALS_API_BASE=http://localhost:8080/api/v1
RENEWALS_API_USER=voice
RENEWALS_API_PASSWORD=voice
VOICE_STT_MODEL=whisper-large-v3-turbo
# Default: groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:$GEMINI_MODEL,mistral:$MISTRAL_MODEL
# (gemini-2.5-flash / mistral-small-latest when those are unset). Providers: groq, gemini, mistral.
# Some keys can't use those two models (retired for new Gemini users, 0 requests/min on Mistral's
# free tier); this chain is known to work on such keys:
# VOICE_LLM_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash,mistral:ministral-14b-latest
VOICE_TTS_VOICE=en-IN-NeerjaNeural
# Origins allowed to call the voice service from a browser (comma separated).
CORS_ORIGINS=http://localhost:5173

# ---- Phone calls (Twilio, optional) -------------------------------------------
# The voice service dials a real phone and streams the call over Twilio Media Streams.
# Trial accounts can only call numbers verified in the Twilio console, play a trial
# notice first and wait for a key press. All five must be set or "Call a phone" stays off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164 (e.g. +15005550006)
TWILIO_FROM=
# Comma-separated E.164 numbers the agent may dial (the web shows them masked).
TWILIO_ALLOWED_TO=
# Public https URL that reaches the voice service, e.g. from
#   cloudflared tunnel --url http://localhost:7861
PUBLIC_BASE_URL=

# Seconds of caller silence before the agent answers a live call (default 1.0)
VOICE_TURN_SETTLE_SECS=1.0

# Escalation: a phone call is transferred to this number (E.164); browser callers hear the helpline number
HUMAN_AGENT_NUMBER=
HELPLINE_NUMBER=1800 210 4455
